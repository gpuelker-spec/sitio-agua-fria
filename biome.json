{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "site.js",
      "estilo/**",
      "modelo/**",
      "scripts/**",
      "conteudo/**",
      "src/**",
      "tests/**",
      "*.config.js",
      "*.config.mjs",
      "biome.json",
      "knip.json",
      "package.json",
      "!index.html",
      "!sentry.min.js",
      "!img"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
