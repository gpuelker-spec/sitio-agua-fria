{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "motion.js",
      "motion.css",
      "src/**",
      "tests/**",
      "*.config.js",
      "*.config.mjs",
      "biome.json",
      "knip.json",
      "package.json",
      "!support.js",
      "!react*.js",
      "!ds-*",
      "!index.html",
      "!sentry.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
